{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "adapters/**/*.ts",
    "providers/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "index.ts"
  ]
}
